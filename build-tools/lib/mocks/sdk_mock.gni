import("//build/ohos.gni")
import("//build/templates/cangjie/cjc_toolchain.gni")

template("mock_sdk_target") {
  all_deps = []
  all_sources = []

  foreach(source, invoker.sources) {
    _sourcename = get_path_info(source, "name")
    _outcpath = "$target_gen_dir/${_sourcename}.c"

    action_with_pydeps("gen_src_${_sourcename}") {
      sources = [ source ]
      script = "//interface/sdk_cangjie/build-tools/lib/mocks/generate_mock.py"
      depfile = "${target_gen_dir}/${target_name}.d"
      args = [
        "--input",
        rebase_path(source),
        "--output",
        rebase_path(_outcpath),
        "--depfile",
        rebase_path(depfile, root_build_dir),
      ]
      outputs = [ _outcpath ]
    }

    all_deps += [ ":gen_src_${_sourcename}" ]
    all_sources += [ _outcpath ]
  }

  ohos_shared_library(target_name) {
    forward_variables_from(invoker,
                           [
                             "subsystem_name",
                             "part_name",
                             "output_extension",
                           ])
    sources = all_sources
    if (defined(invoker.c_sources)) {
      sources += invoker.c_sources
    }
    deps = all_deps
  }
}
